{
  "name": "agent-framework",
  "version": "0.1.0",
  "description": "Minimal, UI-free agent runtime: messages, tools, and a loop. Designed to be embedded as a sub-module of larger agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./faux": {
      "types": "./dist/faux.d.ts",
      "import": "./dist/faux.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs/integration.md",
    "examples"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "invariants": "node scripts/check-invariants.mjs",
    "smoke:openai": "npm run build && node scripts/smoke-openai.mjs",
    "check": "npm run invariants && npm run typecheck && npm run lint && npm run test",
    "smoke:hooks": "npm run build && node scripts/smoke-hooks.mjs",
    "check:package": "node scripts/check-package.mjs",
    "example": "npm run build && node examples/index.mjs",
    "check:all": "npm run check && npm run check:package"
  },
  "dependencies": {
    "openai": "^7.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "oxlint": "^1.9.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
